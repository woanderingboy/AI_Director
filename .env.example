# ════════ AI Director 环境变量模板 ════════
# 使用方法：复制本文件为 .env，并填入真实值
#   cp .env.example .env
# 然后编辑 .env（不要把真实密钥提交到 git，已被 .gitignore 忽略）

# 离线模式：1 = 使用 Mock 数据（无需真实 LLM，可跑通全链路）；0 = 调用真实大模型
AI_DIRECTOR_OFFLINE=1

# ───── 火山引擎（方舟 Ark）配置 ─────
# 方舟 API Key（OpenAI 兼容 /v3/chat/completions）
VOLC_API_KEY=你的方舟API_Key

# 文本生成模型（逗号分隔，第一个作为对话默认模型）
# 示例：glm-5-2-260617, doubao-seed-2-1-turbo-260628
VOLC_TEXT_MODELS=glm-5-2-260617,doubao-seed-2-1-turbo-260628

# 图片生成模型（逗号分隔，额度有限，仅在真正生图时启用）
# 示例：doubao-seedream-5-0-pro-260628, doubao-seedream-5-0-260128
VOLC_IMAGE_MODELS=doubao-seedream-5-0-pro-260628,doubao-seedream-5-0-260128

# 是否将火山引擎设为全局默认服务商：1 = 是；0 = 否（此时回退到 glm）
VOLC_DEFAULT=1

# ───── 可选：其他服务商（不使用时留空即可） ─────
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# GLM_API_KEY=
# QWEN_API_KEY=

# ───── 可选：覆盖全局默认服务商（留空则按 VOLC_DEFAULT 决定） ─────
# 取值：openai / deepseek / volcengine / qwen / glm / custom
# AI_DIRECTOR_DEFAULT_PROVIDER=volcengine
